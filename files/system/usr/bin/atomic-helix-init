#!/usr/bin/bash

set -e

SOURCE="/usr/share/atomic-niri-itterum/helix"
TARGET="${XDG_CONFIG_HOME:-$HOME/.config}/helix"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/atomic-niri-itterum"
MARKER="$STATE_DIR/helix-initialized"

if [ ! -f "$MARKER" ]; then
    mkdir -p "$TARGET" "$STATE_DIR"

    cp -a -n "$SOURCE/." "$TARGET/"

    touch "$MARKER"
fi
