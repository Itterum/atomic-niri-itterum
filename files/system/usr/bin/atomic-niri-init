#!/usr/bin/bash

set -e

SOURCE="/usr/share/atomic-niri-itterum/niri"
TARGET="${XDG_CONFIG_HOME:-$HOME/.config}/niri"

mkdir -p "$TARGET"

cp -f "$SOURCE/config.kdl" "$TARGET/config.kdl"

cp -f "$SOURCE/itterum.kdl" "$TARGET/itterum.kdl"

for file in "$SOURCE"/*; do
    name="$(basename "$file")"

    case "$name" in
        config.kdl|itterum.kdl|dms)
            continue
            ;;
    esac

    if [ ! -e "$TARGET/$name" ]; then
        cp -a "$file" "$TARGET/$name"
    fi
done

if [ -d "$SOURCE/dms" ]; then
    mkdir -p "$TARGET/dms"
    cp -a -n "$SOURCE/dms/." "$TARGET/dms/"
fi
